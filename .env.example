# 复制本文件为 .env 并填入你的知乎开放平台 Access Secret
# 获取途径：
#   1) 知乎开放平台个人中心 https://developer.zhihu.com/profile 申请（邀测）
#   2) 报名黑客松后，赛事专属群/技术答疑群会发放比赛专用 Access Secret + token 补贴
#
# 注意：Access Secret 等同于你的 API 密钥，切勿提交到 Git 或暴露在前端。
ZHIHU_ACCESS_SECRET=

# ---------- 简历结构化抽取用：阶跃星辰（StepFun）API（D-10：优先级高于知乎直答） ----------
# 即使没有知乎 Secret，也能用 StepFun 真实解析简历；不填则回退知乎直答（消耗直答 100 次/天额度）
STEPFUN_API_KEY=
STEPFUN_API_URL=https://api.stepfun.com/step_plan/v1/chat/completions
STEPFUN_MODEL=step-3.7-flash

# ---------- 可选：MarkItDown 文档解析服务（后续拓展，演示链路不依赖，见 docs/DEPLOY.md 方式三） ----------
# 本地启用：pip install "markitdown[all]" && python md_server.py，然后取消下行注释
# MD_SERVICE_URL=http://127.0.0.1:8011

# ---------- 可选：OAuth（MVP 不启用，D-05；代码骨架保留，默认 MOCK 模式） ----------
# ZHIHU_OAUTH_APP_ID=
# ZHIHU_OAUTH_APP_KEY=
# ZHIHU_OAUTH_REDIRECT=http://localhost:3000/api/oauth/callback
# OAUTH_MOCK=true

# 本地服务端口
PORT=3000

# 缓存秒数（知乎接口有调用上限，建议开启本地缓存）
CACHE_TTL=3600
