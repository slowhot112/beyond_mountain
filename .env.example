# 山外山 · 环境变量样例
# 用法：复制本文件为 .env 后填入真实值。.env 已被 git 忽略，不会提交。
# 云端部署（Railway 等）时不用建 .env，直接在平台 Variables 里加同名变量即可。

# 知乎开放平台 Access Secret（赛事发放；不填则跑演示模式，功能仍完整）
OPENAI_API_KEY=
# 旧名兼容（两个都填时优先用 OPENAI_API_KEY）
# ZHIHU_ACCESS_SECRET=

# 知乎直答端点与模型（一般无需改动，默认即知乎直答）
# OPENAI_BASE_URL=https://developer.zhihu.com/v1
# OPENAI_MODEL=zhida-fast-1p5

# ---------- 可选：OAuth 知乎账号授权（MVP 不启用；代码骨架保留，默认 MOCK） ----------
# ZHIHU_OAUTH_APP_ID=
# ZHIHU_OAUTH_APP_KEY=
# ZHIHU_OAUTH_REDIRECT=http://localhost:3000/api/oauth/callback
# OAUTH_MOCK=true

# 简历结构化抽取：优先用阶跃星辰（独立于知乎直答 100 次/天 额度）
# STEPFUN_API_KEY=
# STEPFUN_API_URL=https://api.stepfun.com/step_plan/v1/chat/completions
# STEPFUN_MODEL=step-3.7-flash

# 服务端口（本地默认 3000；云端平台会自动注入，无需设置）
# PORT=3000

# API 响应缓存时长（秒），默认 3600
# CACHE_TTL=3600

# 可选：本地 MarkItDown 文档解析服务地址（线上演示链路不依赖，见 docs/DEPLOY.md）
# MD_SERVICE_URL=http://127.0.0.1:8011
