# 复制本文件为 .env 并填入你的知乎开放平台 Access Secret
# 获取途径：
#   1) 知乎开放平台个人中心 https://developer.zhihu.com/profile 申请（邀测）
#   2) 报名黑客松后，赛事专属群/技术答疑群会发放比赛专用 Access Secret + token 补贴
#
# 注意：Access Secret 等同于你的 API 密钥，切勿提交到 Git 或暴露在前端。
ZHIHU_ACCESS_SECRET=

# ---------- 简历解析用：阶跃星辰（StepFun）API ----------
# 即使没有知乎 Secret，也能用 StepFun 真实解析简历
STEPFUN_API_KEY=
STEPFUN_API_URL=https://api.stepfun.com/step_plan/v1/chat/completions
STEPFUN_MODEL=step-3.7-flash

# 本地服务端口
PORT=3000

# 缓存秒数（知乎接口有调用上限，建议开启本地缓存）
CACHE_TTL=3600
