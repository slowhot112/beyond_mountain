# 山外山 · 环境变量样例
# 用法：复制本文件为 .env 后填入真实值。.env 已被 git 忽略，不会提交。
# 云端部署（Railway 等）时不用建 .env，直接在平台 Variables 里加同名变量即可。

# 知乎开放平台 Access Secret（赛事发放；不填则跑演示模式，功能仍完整）
OPENAI_API_KEY=
# 旧名兼容（两个都填时优先用 OPENAI_API_KEY）
# ZHIHU_ACCESS_SECRET=

# 知乎直答端点与模型（一般无需改动，默认即知乎直答）
# OPENAI_BASE_URL=https://developer.zhihu.com/v1
# OPENAI_MODEL=zhida-fast-1p5

# ---------- 可选：知乎账号登录与行动簿同步 ----------
# 需要先在黑客松活动页创建项目并登记 HTTPS 回调地址。
# 不配置时保持游客模式 + 本地导出/导入，不影响主流程。
# ZHIHU_OAUTH_APP_ID=
# ZHIHU_OAUTH_APP_KEY=
# ZHIHU_OAUTH_REDIRECT=https://你的域名/api/auth/callback
# OAUTH_MOCK=false
# SYNC_STORAGE_KEY=请使用至少32位随机字符串；仅保存在部署平台 Secret
# 注意：当前同步存储写入 .cache/oauth-archives.json。生产环境必须把 .cache 挂载到持久化卷，或替换为托管数据库，不能依赖临时容器磁盘。

# 强制演示模式（即使本机 .env 有密钥也不调用真实 API，适合测试与评审走查）
# DEMO_MODE=true

# ---------- 公开接口防刷与比赛日额度保护（均可选） ----------
# 反向代理部署时才信任 X-Forwarded-For；Railway 会自动识别
# TRUST_PROXY=true
# API_RATE_WINDOW_MS=60000
# API_RATE_LIMIT_HOT=30
# API_RATE_LIMIT_SEARCH=30
# API_RATE_LIMIT_ALCHEMY=6
# API_RATE_LIMIT_ACTIONS=10
# API_RATE_LIMIT_RESUME=6
# API_RATE_LIMIT_CHAT=20
# API_DAILY_HOT_LIMIT=80
# API_DAILY_SEARCH_LIMIT=4000
# API_DAILY_AI_LIMIT=80

# 简历结构化抽取：优先用阶跃星辰（独立于知乎直答 100 次/天 额度）
# STEPFUN_API_KEY=
# STEPFUN_API_URL=https://api.stepfun.com/step_plan/v1/chat/completions
# STEPFUN_MODEL=step-3.7-flash

# 服务端口（本地默认 3000；云端平台会自动注入，无需设置）
# PORT=3000

# API 响应缓存时长（秒），默认 3600
# CACHE_TTL=3600

# 可选：本机构建产物自定义输出目录（仅本地交付目录用；云端无需设置，
# 默认构建到仓库根 dist/ 并由 server.mjs 自动托管，跨平台开箱即用）
# KAN_DIST=E:/kan-dist
